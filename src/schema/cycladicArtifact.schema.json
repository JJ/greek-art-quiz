{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CycladicArtifact",
  "type": "object",
  "properties": {
    "period": { "type": "string", "description": "Period (Grotta-Pelos, Naxos-Syros, Phylakopi)" },
    "subtype": { "type": "string", "description": "Subtype (e.g., folded-arm, violin-shaped)" },
    "pose": { "type": "string", "description": "Posture or morphology" },
    "material": { "type": "string", "description": "Material used" },
    "dimensions": {
      "type": "object",
      "properties": {
        "height": { "type": "number" },
        "width":  { "type": "number" },
        "depth":  { "type": "number" }
      },
      "required": [],
      "description": "Dimensions in cm"
    },
    "provenance": { "type": "string", "description": "Discovery site or museum" },
    "image_url": { "type": "string", "format": "uri", "description": "Image link" },
    "description": { "type": "string", "description": "Textual notes" }
  },
  "required": ["period","subtype","pose","image_url"],
  "additionalProperties": false
}
